        },
        {
          "type": "bar",
          "title": "Protein per Serving by Recipe",
          "sheet": "Recipe Library",
          "category_col": "Recipe",
          "value_cols": [
            "Protein (g)"
          ]
        }
      ],
      "metrics": [
        {
          "label": "Cost per Day",
          "formula": "={Grocery Budget}/7",
          "format": "currency",
          "explain": "Grocery budget spread over the week. Compare with what one takeout meal costs you."
        },
        {
          "label": "Avg Protein / Serving",
          "formula": "=IF(COUNTA({Recipe Library!Recipe})=0,0,AVERAGE({Recipe Library!Protein (g)}))",
          "format": "number",
          "explain": "Average protein across your recipe library. Aim for 25 g or more per main meal."
        },
        {
          "label": "Items Left to Buy",
          "formula": "=COUNTIF({Grocery List!Purchased},\"No\")",
          "format": "number",
          "explain": "Grocery rows still marked No. Zero means you are ready for prep day."
        },
        {
          "label": "Prep Tasks Remaining",
          "formula": "=COUNTIF({Prep Schedule!Status},\"To Do\")",
          "format": "number",
          "explain": "Tasks not yet prepped. The time still needed shows in the insights below."
        }
      ],
      "insights": [
        "=\"Highest-calorie day: \"&INDEX({Weekly Meal Plan!Day},MATCH(MAX({Weekly Meal Plan!Calories}),{Weekly Meal Plan!Calories},0))&\" (\"&TEXT(MAX({Weekly Meal Plan!Calories}),\"#,##0\")&\" kcal); lightest: \"&INDEX({Weekly Meal Plan!Day},MATCH(MIN({Weekly Meal Plan!Calories}),{Weekly Meal Plan!Calories},0))&\".\"",
        "=\"Best protein recipe: \"&INDEX({Recipe Library!Recipe},MATCH(MAX({Recipe Library!Protein (g)}),{Recipe Library!Protein (g)},0))&\" with \"&TEXT(MAX({Recipe Library!Protein (g)}),\"0\")&\" g per serving.\"",
        "=\"Cheapest recipe: \"&INDEX({Recipe Library!Recipe},MATCH(MIN({Recipe Library!Cost / Serving}),{Recipe Library!Cost / Serving},0))&\" at \"&TEXT(MIN({Recipe Library!Cost / Serving}),\"$0.00\")&\" per serving.\"",
        "=\"Prep still to do: \"&COUNTIF({Prep Schedule!Status},\"To Do\")&\" tasks, about \"&TEXT(SUMIF({Prep Schedule!Status},\"To Do\",{Prep Schedule!Time Needed (min)}),\"0\")&\" minutes.\"",
        "=\"Grocery spend bought so far: \"&TEXT(SUMIF({Grocery List!Purchased},\"Yes\",{Grocery List!Est. Cost}),\"$#,##0.00\")&\" of \"&TEXT({Grocery Budget},\"$#,##0.00\")&\".\""
      ]
    }
