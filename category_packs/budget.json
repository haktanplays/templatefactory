    "dashboard": {
      "kpis": [
        {
          "label": "Total Income",
          "sheet": "Monthly Budget",
          "column": "Actual",
          "agg": "sumif",
          "where_column": "Type",
          "equals": "Income",
          "format": "currency"
        },
        {
          "label": "Total Spent",
          "sheet": "Expense Log",
          "column": "Amount",
          "agg": "sum",
          "format": "currency"
        },
        {
          "label": "Total Saved",
          "sheet": "Savings Goals",
          "column": "Saved So Far",
          "agg": "sum",
          "format": "currency"
        },
        {
          "label": "Total Debt",
          "sheet": "Debt Tracker",
          "column": "Balance",
          "agg": "sum",
          "format": "currency"
        }
      ],
