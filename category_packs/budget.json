{
  "category": "budget",
  "theme": "forest",
  "product_name": "Monthly Budget Planner & Expense Tracker",
  "tagline": "See where every dollar goes, hit your savings goals, and pay off debt faster",
  "target_audience": "Individuals and families who want a simple, visual way to manage monthly money",
  "instructions": [
    "Start on the 'Monthly Budget' tab: replace the sample categories and amounts with your own. Income rows stay at the top.",
    "Log purchases on the 'Expense Log' tab as they happen. The Category dropdown keeps your data consistent.",
    "Track savings targets on 'Savings Goals' and debts on 'Debt Tracker'. Progress bars and status colours update automatically.",
    "Open the 'Dashboard' tab any time for your totals and the budget-vs-actual chart. Everything is formula driven, nothing to calculate by hand.",
    "Works in Microsoft Excel (2016+) and Google Sheets (File > Import). Sample data is only there to show you how it works, overwrite it freely."
  ],
  "excel": {
    "currency_symbol": "$",
    "sheets": [
      {
        "name": "Monthly Budget",
        "purpose": "Plan income, expenses and savings for the month and compare against actuals",
        "columns": [
          {
            "name": "Category",
            "type": "text",
            "width": 26
          },
          {
            "name": "Type",
            "type": "dropdown",
            "options": [
              "Income",
              "Fixed Expense",
              "Variable Expense",
              "Savings"
            ],
            "width": 18
          },
          {
            "name": "Budgeted",
            "type": "currency",
            "total": "sum"
          },
          {
            "name": "Actual",
            "type": "currency",
            "total": "sum"
          },
          {
            "name": "Difference",
            "type": "currency",
            "formula": "=IF({Type}=\"Income\",{Actual}-{Budgeted},{Budgeted}-{Actual})",
            "total": "sum",
            "conditional": "negative_red"
          },
          {
            "name": "Notes",
            "type": "text",
            "width": 30
          }
