      {
        "name": "Savings Goals",
        "purpose": "Track progress towards each savings target",
        "columns": [
          {
            "name": "Goal",
            "type": "text",
            "width": 26
          },
          {
            "name": "Target Amount",
            "type": "currency",
            "total": "sum"
          },
          {
            "name": "Saved So Far",
            "type": "currency",
            "total": "sum"
          },
          {
            "name": "Remaining",
            "type": "currency",
            "formula": "={Target Amount}-{Saved So Far}",
            "total": "sum"
          },
          {
            "name": "Progress",
            "type": "percent",
            "formula": "=IF({Target Amount}=0,0,{Saved So Far}/{Target Amount})",
            "conditional": "progress_bar"
          },
          {
            "name": "Target Date",
            "type": "date"
          },
          {
            "name": "Status",
            "type": "dropdown",
            "options": [
