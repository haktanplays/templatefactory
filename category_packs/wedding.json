{
  "category": "wedding",
  "theme": "sunset",
  "product_name": "Wedding Planner & Budget Tracker",
  "tagline": "Budget, vendors, guest list and timeline in one organised workbook",
  "target_audience": "Engaged couples planning their own wedding without a professional planner",
  "instructions": [
    "Begin on 'Wedding Budget': enter your estimate for each category, then update Actual and Deposit Paid as you book vendors. Balance Due calculates itself.",
    "Keep every supplier on 'Vendor Contacts' so phone numbers, emails and contract status are never lost.",
    "Manage invitations on 'Guest List'. The RSVP dropdown colours each row and the attending count feeds the Dashboard.",
    "Work through 'Timeline & Checklist' month by month. Mark tasks Done to see your progress.",
    "The 'Dashboard' shows total budget, amount paid, balance due and confirmed guests at a glance. Works in Excel 2016+ and Google Sheets."
  ],
  "excel": {
    "currency_symbol": "$",
    "sheets": [
      {
        "name": "Wedding Budget",
        "purpose": "Estimate, track payments and see what is still owed per category",
        "columns": [
          {"name": "Category", "type": "text", "width": 22},
          {"name": "Estimated", "type": "currency", "total": "sum"},
          {"name": "Actual", "type": "currency", "total": "sum"},
          {"name": "Deposit Paid", "type": "currency", "total": "sum"},
          {"name": "Balance Due", "type": "currency", "formula": "={Actual}-{Deposit Paid}", "total": "sum", "conditional": "data_bar"},
          {"name": "Due Date", "type": "date"},
          {"name": "Status", "type": "dropdown", "options": ["Not Booked", "Booked", "Paid in Full"], "option_colors": {"Not Booked": "danger", "Booked": "warning", "Paid in Full": "success"}},
          {"name": "Notes", "type": "text", "width": 28}
        ],
        "rows": [
